{
  "name": "@vpf/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "vpf": "./dist/entry.js"
  },
  "dependencies": {
    "@vpf/domain": "0.1.0",
    "@vpf/final-clip": "0.1.0",
    "@vpf/project-bootstrap": "0.1.0",
    "@vpf/legacy-guard": "0.1.0",
    "@vpf/production-system": "0.1.0",
    "@vpf/prelink-handoff": "0.1.0",
    "@vpf/provider-orchestrator": "0.1.0",
    "@vpf/reference-library": "0.1.0",
    "@vpf/resource-registry": "0.1.0",
    "@vpf/runtime-contracts": "0.1.0",
    "@vpf/scene-assets": "0.1.0",
    "@vpf/storage": "0.1.0",
    "@vpf/story": "0.1.0",
    "@vpf/visual-identity": "0.1.0",
    "@vpf/workspace": "0.1.0",
    "@vpf/tts-generation": "0.1.0",
    "@vpf/production-spec": "0.1.0"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @vpf/provider-orchestrator && npm run build --workspace @vpf/storage",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace @vpf/provider-orchestrator && npm run build --workspace @vpf/storage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @vpf/provider-orchestrator && npm run build --workspace @vpf/storage",
    "test": "tsx --test test/**/*.test.ts"
  }
}
