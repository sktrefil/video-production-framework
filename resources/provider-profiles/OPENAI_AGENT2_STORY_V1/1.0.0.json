{
  "schemaVersion": 1,
  "resourceType": "PROVIDER_PROFILE",
  "resourceId": "OPENAI_AGENT2_STORY_V1",
  "version": "1.0.0",
  "payload": {
    "provider": "OPENAI",
    "model": "gpt-5.6",
    "executionMode": "AUTOMATED",
    "jobTypes": ["OTHER"],
    "capabilities": {
      "endpoint": "/v1/responses",
      "webSearch": true,
      "structuredOutputs": true,
      "tasks": ["RESEARCH_FACT_CHECK", "STORY_SCRIPT"]
    },
    "retryPolicy": {
      "maxAttempts": 3,
      "retryableCategories": ["HTTP_429", "HTTP_5XX", "TIMEOUT"]
    },
    "result": {
      "mediaType": "DOCUMENT",
      "requiredArtifacts": ["research_spec", "fact_check_spec", "story_spec", "script"]
    },
    "runtimeSecretNames": ["OPENAI_API_KEY"]
  }
}
