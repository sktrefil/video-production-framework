node_modules/
dist/
coverage/
.env
.env.*
!.env.example

# Unified runtime workspace: code/docs stay tracked, real projects do not.
workspace/projects/**
!workspace/README.md

# Generated editor runtime mirrors and renders are never source.
apps/editor/public/projects/**
apps/editor/public/vpf-active-editor-project.json
apps/editor/public/vpf-active-editor-connection.json
apps/editor/out/**
apps/editor/build/**
apps/editor/.local/**
apps/editor/.remotion/**
out/

temp/
logs/
*.db
*.db-wal
*.db-shm

# Reviewed GitHub project-state snapshots are single-writer SQLite handoffs.
# Runtime databases, transient WAL/SHM files, media, and renders remain local.
!workspace/project-state-snapshots/
!workspace/project-state-snapshots/pilot_short_roman_ix/
!workspace/project-state-snapshots/pilot_short_roman_ix/project.db
local.config.*
.DS_Store

# Local browser/runtime caches and recoverable workspace backups.
.chrome-*/
**/__pycache__/
workspace/_reset_backup/

apps\editor\build
.venv-whisper/

apps\editor\build
